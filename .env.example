# Garage container configuration
GARAGE_RPC_SECRET=change-this-rpc-secret

# Garage S3 client configuration for cmd/main.go
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_BUCKET=fallback-storage
GARAGE_ACCESS_KEY_ID=access
GARAGE_SECRET_ACCESS_KEY=secret
GARAGE_USE_PATH_STYLE=true

# Local fallback storage root
LOCAL_ROOT_DIR=./tmp/local-storage
